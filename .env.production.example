APP_NAME="Tierra Soñada"
APP_ENV=production
APP_KEY=base64:GENERAR_NUEVA_CLAVE_EN_PRODUCCION
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de datos de producción
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tierra_sonada_prod
DB_USERNAME=usuario_prod
DB_PASSWORD=CONTRASEÑA_SEGURA_AQUI

# Sesiones y caché optimizados
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.tu-dominio.com

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ts_

# Redis para mejor rendimiento
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REDIS_PASSWORD_AQUI
REDIS_PORT=6379

# Configuración de email SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sistema@tierra-sonada.com
MAIL_PASSWORD=PASSWORD_EMAIL_AQUI
MAIL_FROM_ADDRESS="sistema@tierra-sonada.com"
MAIL_FROM_NAME="Tierra Soñada"
MAIL_ENCRYPTION=tls

# Amazon S3 para archivos (opcional)
AWS_ACCESS_KEY_ID=TU_AWS_KEY
AWS_SECRET_ACCESS_KEY=TU_AWS_SECRET
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tierra-sonada-files
AWS_USE_PATH_STYLE_ENDPOINT=false

# Variables específicas de producción
VITE_APP_NAME="${APP_NAME}"

# Configuraciones de seguridad adicionales
FORCE_HTTPS=true
SECURE_COOKIES=true

# Configuración de backup (opcional)
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=admin@tierra-sonada.com

# Monitoreo y logs
SENTRY_LARAVEL_DSN=TU_SENTRY_DSN_AQUI